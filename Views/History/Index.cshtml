@model IEnumerable<EchoesOfThePast.Models.Post>

@{
    ViewData["Title"] = "History Archive";
}

<div class="space-y-16">
    <div class="max-w-3xl">
        <h2 class="text-5xl font-serif font-black leading-tight">Preserving the narrative of our collective past.</h2>
        <p class="mt-6 text-xl text-zinc-500 font-serif italic">A community-driven archive for the curious minds, local historians, and students of our heritage.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        @foreach (var post in Model)
        {
            <article class="group bg-white border border-zinc-100 rounded-3xl overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all cursor-pointer flex flex-col" 
                     onclick="location.href='@Url.Action("Details", "History", new { id = post.Id })'">
                @if (!string.IsNullOrEmpty(post.ImageUrl))
                {
                    <div class="aspect-[4/3] overflow-hidden">
                        <img src="@post.ImageUrl" alt="@post.Title" class="w-full h-full object-cover grayscale-[0.5] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" />
                    </div>
                }
                <div class="p-8 flex flex-col flex-grow">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="bg-zinc-100 text-zinc-500 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest">@post.Type</span>
                        <div class="h-px flex-grow bg-zinc-100"></div>
                        <span class="text-[10px] text-zinc-400 font-bold uppercase">@post.CreatedAt.ToString("MMM d, yyyy")</span>
                    </div>
                    
                    <h3 class="text-2xl mb-4 group-hover:text-zinc-700 transition-colors">@post.Title</h3>
                    <p class="text-zinc-500 line-clamp-3 text-sm leading-relaxed mb-6">@post.Content</p>

                    <div class="flex items-center justify-between pt-6 border-t border-zinc-50">
                        <div class="flex items-center gap-2 text-zinc-400 italic text-sm font-serif">
                            <span>@post.AuthorName</span>
                        </div>
                        <div class="p-2 text-zinc-300 group-hover:text-zinc-900 group-hover:translate-x-1 transition-all">
                            <i class="lucide-arrow-right"></i>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</div>
